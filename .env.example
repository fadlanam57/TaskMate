# =============================================================================
# TaskMate Environment Variables Example
# Salin file ini menjadi .env dan isi dengan connection string PostgreSQL Supabase Anda
# =============================================================================

# Connection String PostgreSQL (Dapatkan dari Supabase Dashboard: Project Settings -> Database -> Connection string -> URI)
# Contoh format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=
